    },
    "Checked %lld category months against YNAB's plan: %lld amounts differ." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمت مقارنة %1$lld من أشهر الفئات بخطة YNAB: %2$#@found@."
          },
          "substitutions" : {
            "found" : {
              "argNum" : 2,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "zero" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "لا مبالغ مختلفة"
                    }
                  },
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "مبلغ واحد مختلف"
                    }
                  },
                  "two" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "مبلغان مختلفان"
                    }
                  },
                  "few" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg مبالغ مختلفة"
                    }
                  },
                  "many" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg مبلغًا مختلفًا"
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "%arg مبلغ مختلف"
                    }
                  }
                }
              }
            }
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checked %1$lld category months against YNAB's plan: %2$#@found@."
          },
