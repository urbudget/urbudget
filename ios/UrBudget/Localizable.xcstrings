        }
      }
    },
    "Create a budget or open one from your account library." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنشئ ميزانية أو افتح ميزانية من مكتبة حسابك."
