{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UrBudget",
  "version": "1.0.9",
  "identifier": "com.localbudget.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "UrBudget",
        "width": 1360,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 680,
        "backgroundColor": "#f5f6f8",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Finance",
    "shortDescription": "Your budget, on your computer.",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU5MzIzMzczNUFBMDEyMjYKUldRbUVxQmFjek15NllhT1VBd2NlN3kycnJ1aDVrRDdpZ0JGeWRyQnVZT0JYc2tJdExkSWlBc0UK",
      "endpoints": [
        "https://urbudget.app/api/v1/releases/update/{{target}}/{{arch}}/{{current_version}}"
      ],
      "requireSignedVersion": true
    }
  }
}
