{
  "bundle": {
    "targets": [
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "publisher": "UrBudget",
    "longDescription": "A private envelope budget that keeps your data on your own computer. Free and open source."
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://urbudget.app/api/v1/releases/update/{{target}}/{{arch}}/{{current_version}}?bundle={{bundle_type}}"
      ]
    }
  }
}
